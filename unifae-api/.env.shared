# ─────────────────────────────────────────────────────────────────────────────
# .env.shared — variáveis NÃO-SECRETAS compartilhadas entre todas as máquinas
# Versionado no git. Segredos (senhas, chaves) ficam apenas no .env local.
# ─────────────────────────────────────────────────────────────────────────────

# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados — credenciais ficam no .env local
DB_HOST=localhost
DB_PORT=3306
DB_NAME=unifae_management
TYPEORM_SYNC=false

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_EXPIRES_IN=8h

# Uploads
UPLOAD_ROOT=uploads
UPLOAD_MAX_MB=50

# Swagger
SWAGGER_ENABLED=true

# E-mail — credenciais ficam no .env local
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_FROM=UNIFAE Hub <noreply@unifae.local>

# Google Meet
GOOGLE_MEET_ENABLED=false
GOOGLE_MEET_STUB_BASE_URL=https://meet.google.com/stub-demo

# Password Reset
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
