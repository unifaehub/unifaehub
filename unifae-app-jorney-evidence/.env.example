# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env

# IP da máquina de desenvolvimento na rede Wi-Fi local
# Para descobrir: rode "ipconfig" e use o IPv4 da interface Wi-Fi
# Exemplo: 192.168.3.90
EXPO_PUBLIC_API_BASE=http://SEU_IP_AQUI:3000/api/v1

# Força o QR code do Metro a usar o IP correto (mesmo valor acima)
REACT_NATIVE_PACKAGER_HOSTNAME=SEU_IP_AQUI
