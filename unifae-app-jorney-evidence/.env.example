# O app detecta o IP da máquina automaticamente via Metro Bundler.
# Normalmente não é necessário criar um .env local.
#
# Só configure estas variáveis se a detecção automática falhar
# (ex.: emulador, VPN, rede corporativa):

# Porta da API NestJS (padrão: 3000)
# EXPO_PUBLIC_API_PORT=3000

# URL completa da API (sobrescreve a detecção automática)
# EXPO_PUBLIC_API_BASE=http://192.168.x.x:3000/api/v1
