{
  "expo": {
    "name": "UNIFAE Intercurso",
    "slug": "unifae-app-intercurso",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "unifae-intercurso",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d4ed8"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1d4ed8"
      },
      "package": "br.edu.unifae.intercurso"
    },
    "ios": {
      "bundleIdentifier": "br.edu.unifae.intercurso"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ]
  }
}
